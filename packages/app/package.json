{
  "name": "rota",
  "productName": "Rota",
  "version": "0.1.0",
  "description": "Local recurring task engine with a graphical interface, living in the system tray.",
  "homepage": "https://github.com/mathieuancelin/rota",
  "author": {
    "name": "Mathieu Ancelin",
    "email": "mathieu.ancelin@gmail.com"
  },
  "license": "MIT",
  "private": true,
  "main": "src/main/index.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "postinstall": "install-electron",
    "start": "node scripts/dev.js",
    "build": "vite build",
    "icons": "node scripts/generate-icons.js && iconutil -c icns assets/app/icon.iconset -o build/icon.icns",
    "screenshots": "node scripts/screenshots.js",
    "package": "npm run build && node scripts/bundle-daemon.js && electron-builder --mac --arm64",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@rota/core": "*"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "dompurify": "^3.4.12",
    "electron": "43.2.0",
    "electron-builder": "^26.15.3",
    "marked": "^15.0.12",
    "monaco-editor": "^0.56.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.2.0"
  }
}
